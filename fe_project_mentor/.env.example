# 小游的配置。复制成 .env.local 再填（.env.local 已被 gitignore，不会进仓）。
#
# Next.js 会在服务端启动时自动加载 .env.local，所以配置跟着项目走，
# 不依赖你从哪个 shell 启动 `yarn dev`。

# ---- 大模型接入 ----
# 优先读 XIAOYOU_*，读不到再回落到 ANTHROPIC_*
# 走代理（如火山方舟）时 baseURL 必填；走官方端点可留空
XIAOYOU_BASE_URL=
# 代理一般用 Bearer token（对应 SDK 的 authToken），官方端点用 apiKey
XIAOYOU_AUTH_TOKEN=
XIAOYOU_API_KEY=

# 模型名。不填则回落 ANTHROPIC_DEFAULT_SONNET_MODEL / ANTHROPIC_DEFAULT_OPUS_MODEL；
# 两者都没有会直接报错，不会静默用空模型名去请求。
XIAOYOU_MODEL=
XIAOYOU_STRONG_MODEL=

# 模型位的兜底（和 Claude Code 用同一套配置时，这两个通常已经在你 shell 里了）
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

# ---- 运行 ----
# 知识产物暂存目录，默认 <项目目录>/.xiaoyou
XIAOYOU_STAGING_DIR=
# 允许扫描的根目录，用系统路径分隔符分隔；默认 <项目目录>/../gitlab
XIAOYOU_ALLOWED_ROOTS=
