            "title": "滴速无法填写滴速与默认滴速范围",
            "userid": 141086,
            "fact_finish_time": "2026-10-10 18:03:42",
            "demand_level": "###{\"background\":\"#427BFF\",\"icon\":\"icon-dot-huifu\",\"value\":\"3\",\"change_text\":\"中\"}",
            "max_hour": 8,
            "demand_id": "577054616714625711",
